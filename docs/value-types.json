        "type": "object",
        "properties": {
          "__type": {
            "const": "Faces"
          },
          "top": {
            "type": "boolean"
          },
          "bottom": {
            "type": "boolean"
          },
          "left": {
            "type": "boolean"
          },
          "right": {
            "type": "boolean"
          },
          "front": {
            "type": "boolean"
          },
          "back": {
            "type": "boolean"
          }
        },
        "required": [
          "__type"
        ],
        "additionalProperties": false
      },
      "notes": "Omitted face flags default to false. Provided flags must be booleans."
    },
    {
      "name": "Axes",
      "encode": true,
      "decode": true,
      "example": {
