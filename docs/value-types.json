        "x": true,
        "y": true,
        "z": false
      },
      "schema": {
        "type": "object",
        "properties": {
          "__type": {
            "const": "Axes"
          },
          "x": {
            "type": "boolean"
          },
          "y": {
            "type": "boolean"
          },
          "z": {
            "type": "boolean"
          }
        },
        "required": [
          "__type"
        ],
        "additionalProperties": false
      },
      "notes": "Omitted axis flags default to false. Provided flags must be booleans."
    },
    {
      "name": "PhysicalProperties",
      "encode": true,
      "decode": true,
      "example": {
        "__type": "PhysicalProperties",
        "density": 1,
        "friction": 0.5,
        "elasticity": 0,
        "frictionWeight": 1,
        "elasticityWeight": 1
      },
      "schema": {
        "type": "object",
        "properties": {
          "__type": {
            "const": "PhysicalProperties"
          },
          "density": {
            "type": "number"
          },
          "friction": {
            "type": "number"
          },
          "elasticity": {
            "type": "number"
          },
          "frictionWeight": {
            "type": "number"
          },
          "elasticityWeight": {
            "type": "number"
          },
          "acousticAbsorption": {
            "type": "number"
          }
        },
        "required": [
          "__type",
          "density",
          "friction",
          "elasticity"
        ],
        "additionalProperties": false
      },
      "notes": "Weights default to 1. Finite inputs are passed through; Roblox clamps density to [0.0001,100], friction to [0,2], elasticity to [0,1], weights to [0,100], and optional acousticAbsorption to [0,1]. acousticAbsorption requires a Studio version supporting the sixth constructor argument; encoding includes it only when available. Read back the property for normalized values."
    },
    {
      "name": "InstancePath",
      "encode": true,
      "decode": true,
      "example": {
        "__type": "InstancePath",
        "path": "Workspace/Box"
      },
      "schema": {
        "type": "object",
        "properties": {
          "__type": {
            "const": "InstancePath"
          },
          "path": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "rooted": {
            "const": true
          }
        },
        "required": [
          "__type",
          "path"
        ],
        "additionalProperties": false
      },
      "notes": "path resolves an existing instance; empty path means DataModel. class is ignored metadata. Output may carry rooted:false for an unparented instance; that value cannot be resolved or written back."
    },
    {
      "name": "Number",
      "encode": true,
      "decode": true,
      "example": {
        "__type": "Number",
        "value": "inf"
      },
      "schema": {
        "type": "object",
        "properties": {
          "__type": {
            "const": "Number"
          },
          "value": {
            "type": "string",
            "enum": [
              "nan",
              "inf",
              "-inf"
            ]
          }
        },
        "required": [
          "__type",
          "value"
        ],
        "additionalProperties": false
      },
      "notes": "Non-finite scalar numbers only. Property/method-specific restrictions still apply."
    },
    {
      "name": "BinaryString",
      "encode": true,
      "decode": true,
      "example": {
        "__type": "BinaryString",
        "base64": "aGk=",
        "bytes": 2
      },
      "schema": {
        "type": "object",
        "properties": {
          "__type": {
            "const": "BinaryString"
          },
          "base64": {
            "type": "string",
            "format": "base64"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          }
        },
        "required": [
          "__type",
          "base64"
        ],
        "additionalProperties": false
      },
      "notes": "base64 is strict padded RFC 4648. Optional bytes metadata must match decoded length. BinaryString decodes to a raw Luau string; Buffer decodes to a Luau buffer. Valid UTF-8 strings may encode back as plain JSON strings."
    },
