              "ExtraLight",
              "Light",
              "Regular",
              "Medium",
              "SemiBold",
              "Bold",
              "ExtraBold",
              "Heavy"
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "Normal",
              "Italic"
            ]
          }
        },
        "required": [
          "__type",
          "family",
          "weight",
          "style"
        ],
        "additionalProperties": false
      },
      "notes": ""
    },
    {
      "name": "Faces",
      "encode": true,
      "decode": true,
      "example": {
